{
  "name": "blog-backend",
  "version": "1.0.0",
  "description": "Express + SQLite REST API for the PFL blog framework comparison (same API contract as the old json-server backend)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
