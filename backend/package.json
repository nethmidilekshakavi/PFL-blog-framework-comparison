    "test:coverage": "vitest run --coverage"
  },
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
}
